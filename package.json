{
  "name": "kus-episodes",
  "version": "1.0.0",
  "description": "Kack & Sachgeschichten – Episodenübersicht",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test:format-rules": "node tests/format-rules.test.mjs",
    "test:format-coverage": "node scripts/check-format-coverage.mjs",
    "test:guest-normalization": "node tests/guest-normalization.test.mjs",
    "test:topic-normalization": "node tests/topic-normalization.test.mjs",
    "test:works-entity": "node tests/works-entity.test.mjs",
    "test:suggestion-clusters": "node tests/suggestions-cluster-approve.test.mjs",
    "search:index": "node scripts/build-search-index.mjs",
    "test:search": "node --test tests/search.test.mjs",
    "test": "npm run test:format-rules && npm run test:guest-normalization && npm run test:topic-normalization && npm run test:works-entity && npm run test:suggestion-clusters && npm run test:search && npm run test:ui",
    "test:ui": "node --test tests/ui.test.mjs",
    "search:evaluate": "node scripts/evaluate-search.mjs"
  },
  "dependencies": {
    "dotenv": "^17.4.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.2",
    "minisearch": "^7.2.0",
    "node-cron": "^4.2.1",
    "node-fetch": "^2.7.0",
    "openai": "^6.33.0",
    "sql.js": "^1.12.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "jsdom": "^31.0.0"
  },
  "overrides": {
    "qs": "6.17.1"
  }
}
