# Local development. Generate a private random ADMIN_TOKEN; never reuse production secrets.
HOST=127.0.0.1
PORT=3108
TZ=Europe/Zurich
TRUST_PROXY=0
ADMIN_TOKEN=
APP_BASE_URL=http://localhost:3108

# Optional semantic search. Without it, full-text search and filters still work.
# Requires a current Ollama version supporting this model (tested: 0.40.16).
EMBEDDING_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=embeddinggemma-2
# Required for a protected remote encoder. Keep this credential out of Git.
# EMBEDDING_AUTHORIZATION=Basic <base64-user-and-password>
EMBEDDING_TIMEOUT_MS=3000
SEARCH_INDEX_PATH=data/search-index.json
# Rebuild after the existing nightly RSS job; leave off until the encoder is reliably reachable.
SEARCH_AUTO_INDEX=0
# ENTITY_REGISTRY_PATH=data/entity-decisions.json

# Optional extraction and Telegram; NOT needed for search.
OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=
